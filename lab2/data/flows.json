    {
        "id": "33fce571c80af840",
        "type": "function",
        "z": "a5bd1c801face3e5",
        "name": "function 4",
        "func": "const id = msg.req.params.id;\nconst query = msg.req.query;\n\n// Проверка: если id не число → 400 Bad Request\nif (isNaN(Number(id))) {\n    msg.statusCode = 400;\n    msg.payload = {\n        error: \"Bad Request\",\n        message: \"Параметр id должен быть числом\",\n        received: id\n    };\n    msg.headers = { \"Content-Type\": \"application/json\" };\n    return msg;\n}\n\n// Проверка: если id = 999 → 404 Not Found\nif (Number(id) === 999) {\n    msg.statusCode = 404;\n    msg.payload = {\n        error: \"Not Found\",\n        message: \"Элемент с таким id не найден\"\n    };\n    msg.headers = { \"Content-Type\": \"application/json\" };\n    return msg;\n}\n\n// Успешный ответ\nmsg.statusCode = 200;\nmsg.payload = {\n    id: Number(id),\n    name: \"Элемент #\" + id,\n    query: query,\n    message: \"OK\"\n};\nmsg.headers = { \"Content-Type\": \"application/json\" };\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
