    {
        "id": "e6de3ab34c8f6abd",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "обработка чисел",
        "func": "let input = msg.payload;\nconst numbers = [1, 2, 3, 4, 5];\nlet sum = 0;\n\nfor (let i = 0; i < numbers.length; i++) {\n    sum += numbers[i];\n}\n\nlet message;\nif (input >= 10) {\n    message = \"Большое число\";\n} else if (input >= 5) {\n    message = \"Среднее число\";\n} else {\n    message = \"Маленькое число\";\n}\n\nconst result = {\n    input: input,\n    sum: sum,\n    count: numbers.length,\n    message: message,\n    timestamp: new Date().toISOString()\n};\n\nmsg.payload = result;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 750,
        "y": 420,
        "wires": [
