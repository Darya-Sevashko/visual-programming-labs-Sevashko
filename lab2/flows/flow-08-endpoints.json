        "type": "http in",
        "z": "a5bd1c801face3e5",
        "name": "GET /api/items/:id",
        "url": "/api/items/:id",
        "method": "get",
        "upload": false,
        "skipBodyParsing": false,
        "swaggerDoc": "",
        "x": 670,
